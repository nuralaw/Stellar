{
  "name": "stellar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bank:import": "node scripts/bank-import.mjs",
    "bank:build": "node scripts/bank-build.mjs",
    "bank:check": "node scripts/bank-build.mjs --check",
    "prebuild": "npm run tests:build && npm run bank:build",
    "predev": "npm run tests:build && npm run bank:build",
    "bank:review": "node scripts/bank-review.mjs",
    "tests:import": "python scripts/tests-import.py",
    "tests:build": "node scripts/tests-build.mjs",
    "tests:check": "node scripts/tests-build.mjs --check",
    "lessons:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lessons-check.mjs",
    "lessons:questions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lessons-questions.mjs",
    "lessons:visuals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/lessons-visuals.mjs",
    "vocab:build": "node scripts/vocab-build.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "gumroad:setup": "node scripts/gumroad-setup.mjs",
    "data:seal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seal-existing.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
