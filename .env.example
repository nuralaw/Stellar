# Desmos graphing calculator — key from https://www.desmos.com/my-api
NEXT_PUBLIC_DESMOS_API_KEY=

# Storage for the weekly competition, question reports and support requests (server-only).
# Without these, everything goes to .data/ (local dev only). Run the SQL files in supabase/ once.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (browser-safe): Project URL + publishable key. Used for the admin sign-in at /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Who can open /admin (Support list): confirmed Supabase user emails, comma-separated.
ADMIN_EMAIL=

# Email a copy of every support request (Resend, resend.com → API Keys).
# Without SUPPORT_EMAIL_FROM on a verified domain, Resend's test sender only delivers to the Resend account's email.
RESEND_API_KEY=
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=

# Plausible (optional, after the domain + Vercel Pro). Leave empty = off: no script, no requests.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN turns it on: the site's domain exactly as added in Plausible (e.g. stellar1600.com).
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT: the site-specific script URL from Plausible → Site settings → Site installation
#   (looks like https://plausible.io/js/pa-XXXXX.js). Empty = <PLAUSIBLE_HOST>/js/script.js (older generic script).
# Both are read at build time (script proxy rewrites in next.config.ts + the client snippet): redeploy after changing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT=
# Server-only, for the Stats API behind /admin → Traffic (Plausible → Account settings → API keys; site id = the domain).
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
# Only for a self-hosted Plausible Community Edition; default https://plausible.io.
PLAUSIBLE_HOST=

# Only for `npm run db:apply` (runs the SQL files in supabase/ for you). Never needed by the site itself, never put it on Vercel.
# Supabase -> Connect -> Session pooler -> copy the connection string and put your database password in it.
SUPABASE_DB_URL=

# Gumroad (Stellar Plus payments). Setup checklist: docs/PAYMENTS.md. All server-only except the two NEXT_PUBLIC links.
# Gumroad -> Settings -> Advanced -> Ping: URL https://<site>/api/gumroad/ping, with signing on; its secret goes here.
GUMROAD_PING_SECRET=
# Any long random string; `npm run gumroad:setup` puts it in the webhook URLs it registers (?key=...).
GUMROAD_WEBHOOK_KEY=
# Gumroad -> Settings -> Advanced -> Applications -> generate an access token. Used to double-check refunds, disputes and ended memberships.
GUMROAD_ACCESS_TOKEN=
# Optional: your Gumroad seller id. When set, pings from any other seller are rejected.
GUMROAD_SELLER_ID=
# Product ids (comma-separated; add the custom permalink too if you set one) of the two products. Anything else is stored but gives no Plus.
GUMROAD_PRODUCT_MONTHLY=
GUMROAD_PRODUCT_PASS=
# The product page URLs (browser-safe, read at build time: redeploy after changing). Empty = that plan isn't on sale.
NEXT_PUBLIC_GUMROAD_MONTHLY_URL=
NEXT_PUBLIC_GUMROAD_PASS_URL=
# Name of the ONE shared Gumroad offer code for bug-report discounts (50%, Monthly only, first billing period only, no use limit).
# Server-only. Without it, discounts are recorded but not applied. See docs/PAYMENTS.md -> Bug-report discounts.
GUMROAD_BUG_CODE=
